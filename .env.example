# Copy to .env and fill in. Never commit .env.

# Website login for NGOs and volunteers (required to open the website)
KP_ADMIN_USER=admin
KP_ADMIN_PASSWORD=change-me

# Gemini (https://aistudio.google.com/apikey). Leave empty to run with the offline text parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Embeddings for matching workers to work openings
GEMINI_EMBED_MODEL=gemini-embedding-001

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-random-string
WA_APP_SECRET=
WA_API_VERSION=v21.0

# Public URL of this server. WhatsApp downloads PDFs from here, so it must be reachable from the internet.
KP_PUBLIC_BASE_URL=http://localhost:8000

# Storage
KP_DB_PATH=data/kaampramaan.db
KP_MEDIA_DIR=data/media

# Dates are recorded in this time zone
KP_TIMEZONE=Asia/Kolkata
